# ==============================================================
# CryoTrace: Intelligent Cold-Chain Logistics Dispatch Platform
# Environment Configuration Template
# ==============================================================

# 1. DATABASE CONFIGURATION (Microsoft SQL Server 2022)
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_ADMIN_USER=sa
SQL_ADMIN_PASSWORD=FdeEnterprisePass123!
SQL_AGENT_USER=USR_FDE_RO
SQL_AGENT_PASSWORD=AgentPassword2026!

# 2. VECTOR DATABASE (Pinecone)
# Sign up and obtain a free API key at https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here

# 3. EMBEDDING MODEL CONFIGURATION
# Options: "LOCAL" (uses BAAI/bge-m3 dense embeddings) or "OPENAI"
Embeddings_model=LOCAL
Local_Embedding_Model=BAAI/bge-m3

# 4. AGENT REASONER LLM CONFIGURATION
# Options: "GROQ" (recommended, ultra-fast), "OPENAI" (gpt-4o), "DEEPSEEK", or "OLLAMA"
Agent_llm=GROQ

# 5. LLM API KEYS
# Groq: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (Optional if using Agent_llm=OPENAI)
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek (Optional if using Agent_llm=DEEPSEEK)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
